# Copy to ~/.darkarchon/agent.config and edit.
#
# One config per host, not per team: the agent scans every tmux pane on the
# machine and reports them all under a single HOST_ID.

# Main PC hub URL (LAN IP). Mandatory.
HUB_URL=http://192.168.0.10:8774

# Identifier shown in the dashboard. Defaults to hostname if omitted.
HOST_ID=main-pc

# Parent of the per-team state dirs. Defaults to ~/.darkarchon. The agent sweeps
# every team under it for workers-runtime.env, heartbeats and hook state, so a
# worker is resolved to its registered name regardless of which team spawned it.
# A host with no team dirs (a remote PC that only runs workers) finds nothing
# here and reports its panes as 'discovered' — that is expected.
STATE_ROOT=

# Scan interval in seconds.
INTERVAL=5

# Comma-separated list of LLM CLI process names to discover.
# Include 'node' because Claude Code on macOS often shows up as the node
# runtime in tmux's pane_current_command instead of "claude". The scanner
# verifies with a Claude prompt marker before classifying, so unrelated
# node panes won't be misreported.
LLM_PROCESSES=claude,node

# Comma-separated tmux window names. Any pane in a window with these names
# is treated as an LLM worker regardless of the process name. Mark a pane
# explicitly with `tmux rename-window claude` (or whatever you put here).
# Add 'codex', 'gemini', etc. as you start using those LLMs.
LLM_WINDOWS=claude
