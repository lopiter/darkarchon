# darkarchon — tmux-based claude code worker coordination.
#
# Lightweight infrastructure for running multiple claude code instances
# in parallel tmux windows, with file-based message passing.
#
# Sourced by every script via lib/_lib.sh.

# Tool brand prefix — parent of state dirs (~/.<TOOL_PREFIX>/<team>/).
TOOL_PREFIX=darkarchon

# Team name — distinguishes parallel sets of workers (e.g. multiple
# worktrees of the same repo running side by side, or per-project teams
# on the same machine).
#
# Override per-shell with DARKARCHON_TEAM. Recommended setup with direnv:
#   echo 'export DARKARCHON_TEAM=feature-x' > .envrc
#
# Workers spawned in shells with different DARKARCHON_TEAM values land in
# different tmux sessions and write to different STATE_DIR — fully isolated.
SESSION_NAME="${DARKARCHON_TEAM:-default}"

TASK_TIMEOUT=300
POLL_INTERVAL=3
CLAUDE_FLAGS="--permission-mode auto"

# Codex worker launch flags (used by lib/start-worker-codex.sh). The bypass flag
# skips approval prompts and the sandbox so codex can work autonomously in a
# trusted local pane — mirrors how oh-my-claudecode launches its codex team
# workers. CODEX_MODEL is optional (empty = codex default model).
CODEX_FLAGS="--dangerously-bypass-approvals-and-sandbox"
CODEX_MODEL=""

# State directory — task history, mailbox, questions, worker registry.
STATE_DIR="$HOME/.${TOOL_PREFIX}/${SESSION_NAME}"

# Optional: project-specific worker prompt context, layered on top of the
# generic role prompts in prompts/. Export DARKARCHON_PROMPT_DIR to enable.
TEAM_CONTEXT_DIR="${DARKARCHON_PROMPT_DIR:-}"

# Empty workers list — workers are spawned on demand via spawn-worker.sh.
# `start.sh` will iterate this list and call spawn-worker.sh for each entry,
# so populate it only if you want a fixed roster on `start.sh`.
WORKERS=()
